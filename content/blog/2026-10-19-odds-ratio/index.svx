<script lang="ts">
  import TrialDots from "#lib/components/odds/TrialDots.svelte";
  import RiskOddsDots from "#lib/components/odds/RiskOddsDots.svelte";
  import LogisticCurve from "#lib/components/odds/LogisticCurve.svelte";
  import StrataCurve from "#lib/components/odds/StrataCurve.svelte";
  import CaseControlDots from "#lib/components/odds/CaseControlDots.svelte";
  import Tex from "#lib/components/Tex.svelte";

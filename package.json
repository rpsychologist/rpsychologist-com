{
	"name": "rpsychologist-com",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"packageManager": "pnpm@11.9.0",
	"browserslist": [
		"defaults"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/pagefind-index.mjs",
		"preview": "node scripts/serve-build.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && prettier --check .",
		"check:tags": "node scripts/check-release-tags.mjs",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"lint": "eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/d3-array": "^3.2.2",
		"@types/d3-contour": "^3.0.6",
		"@types/d3-dsv": "^3.0.7",
		"@types/d3-format": "^3.0.4",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.2.0",
		"@types/node": "^25.9.9",
		"browserslist": "^4.29.4",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"github-slugger": "^2.0.0",
		"globals": "^17.13.0",
		"gray-matter": "^4.0.3",
		"lightningcss": "^1.33.0",
		"mdast-util-from-markdown": "^2.1.0",
		"mdast-util-to-string": "^4.0.0",
		"mdsvex": "^0.12.8",
		"pagefind": "1.5.2",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-katex": "^6.0.3",
		"rehype-slug": "^6.0.0",
		"remark-math": "^3.0.1",
		"remark-smartypants": "^3.0.3",
		"shiki": "^4.5.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.0",
		"unist-util-visit": "^5.1.0",
		"vite": "^8.3.5",
		"vitest": "^4.1.12",
		"zod": "^4.6.7"
	},
	"dependencies": {
		"d3-array": "^3.2.4",
		"d3-contour": "^4.0.2",
		"d3-dsv": "^3.0.1",
		"d3-format": "^3.1.2",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"katex": "^0.16.47"
	}
}

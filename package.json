		"@sveltejs/kit": "^2.68.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/d3-array": "^3.2.2",
		"@types/d3-dsv": "^3.0.7",
		"@types/d3-format": "^3.0.4",
